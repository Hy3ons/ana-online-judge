{
  "name": "aoj-vscode",
  "displayName": "ANA Online Judge",
  "description": "Solve AOJ problems from VS Code: sync problems, run testcases locally, submit, watch verdicts live.",
  "version": "0.1.0",
  "publisher": "ana-online-judge",
  "private": true,
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/csh1668/ana-online-judge"
  },
  "bugs": {
    "url": "https://github.com/csh1668/ana-online-judge/issues"
  },
  "homepage": "https://github.com/csh1668/ana-online-judge#readme",
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:javascript",
    "onAuthenticationRequest:aoj"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "aoj",
        "label": "ANA Online Judge"
      }
    ],
    "commands": [
      {
        "command": "aoj.signIn",
        "title": "AOJ: Sign in",
        "category": "AOJ"
      },
      {
        "command": "aoj.signOut",
        "title": "AOJ: Sign out",
        "category": "AOJ"
      },
      {
        "command": "aoj.searchProblems",
        "title": "AOJ: Search Problems",
        "category": "AOJ"
      },
      {
        "command": "aoj.syncProblemById",
        "title": "AOJ: Attach Problem (legacy alias)",
        "category": "AOJ"
      },
      {
        "command": "aoj.attachProblemById",
        "title": "AOJ: Attach Problem by ID...",
        "category": "AOJ"
      },
      {
        "command": "aoj.dashboard.refresh",
        "title": "AOJ: Refresh Dashboard",
        "category": "AOJ"
      },
      {
        "command": "aoj.runAll",
        "title": "AOJ: Run All Testcases",
        "category": "AOJ"
      },
      {
        "command": "aoj.runOne",
        "title": "AOJ: Run This Testcase",
        "category": "AOJ"
      },
      {
        "command": "aoj.submit",
        "title": "AOJ: Submit Current File",
        "category": "AOJ"
      },
      {
        "command": "aoj.openStatement",
        "title": "AOJ: Open Problem Statement",
        "category": "AOJ"
      },
      {
        "command": "aoj.openInBrowser",
        "title": "AOJ: Open in Browser",
        "category": "AOJ"
      },
      {
        "command": "aoj.addTestcase",
        "title": "AOJ: Add Testcase",
        "category": "AOJ"
      },
      {
        "command": "aoj.removeTestcase",
        "title": "AOJ: Remove Testcase",
        "category": "AOJ"
      }
    ],
    "keybindings": [
      {
        "command": "aoj.runAll",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "aoj.submit",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "aoj.openStatement",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aoj",
          "title": "ANA Online Judge",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "aoj": [
        {
          "id": "aoj.dashboard",
          "name": "AOJ",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aoj.signIn",
          "when": "view == aoj.dashboard && !aoj.signedIn",
          "group": "navigation"
        },
        {
          "command": "aoj.signOut",
          "when": "view == aoj.dashboard && aoj.signedIn",
          "group": "1_overflow"
        }
      ]
    },
    "configuration": {
      "title": "ANA Online Judge",
      "properties": {
        "aoj.endpoint": {
          "type": "string",
          "default": "https://aoj.example.com",
          "description": "AOJ 웹 base URL"
        },
        "aoj.compilerPaths": {
          "type": "object",
          "default": {
            "cpp": "g++",
            "c": "gcc",
            "python": "python3",
            "rust": "rustc",
            "go": "go",
            "java": "javac",
            "javascript": "node"
          },
          "description": "언어별 컴파일러/런타임 경로"
        },
        "aoj.compileFlags": {
          "type": "object",
          "default": {
            "cpp": [
              "-O2",
              "-std=c++20"
            ],
            "c": [
              "-O2",
              "-std=c17"
            ],
            "rust": [
              "-O"
            ],
            "go": [],
            "java": [
              "-encoding",
              "UTF-8"
            ]
          },
          "description": "언어별 컴파일 플래그"
        },
        "aoj.timeoutMultiplier": {
          "type": "number",
          "default": 2,
          "minimum": 0.5,
          "maximum": 10,
          "description": "로컬 실행 timeout = 문제 시간제한 × 이 값"
        },
        "aoj.confirmSubmit": {
          "type": "boolean",
          "default": true,
          "description": "제출 전 확인 대화상자 표시"
        },
        "aoj.testcaseSidecarDir": {
          "type": "string",
          "default": ".aoj",
          "description": "사이드카(.json) 디렉토리 이름"
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm build:css && node esbuild.config.mjs",
    "watch": "pnpm build:css && node esbuild.config.mjs --watch",
    "package": "pnpm build:css && node esbuild.config.mjs --production",
    "build:css": "tailwindcss -i webview/shared/tailwind.css -o dist/webview/styles.css --minify",
    "watch:css": "tailwindcss -i webview/shared/tailwind.css -o dist/webview/styles.css --watch",
    "lint": "biome check src test webview",
    "lint:fix": "biome check --fix src test webview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm build && pnpm build:integration && node ./test/integration/runner.cjs",
    "build:integration": "tsc -p test/integration/tsconfig.json",
    "vsce:package": "vsce package --no-dependencies --out aoj-vscode.vsix",
    "vsce:publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-highlightjs": "^4.2.0",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@tailwindcss/cli": "^4.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "mocha": "^11.0.0",
    "ovsx": "^0.10.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
